# ============================================================================
# CONQUISTADOR OS - Variables d'environnement
# Copier ce fichier en ".env" pour le developpement local (netlify dev le lit
# automatiquement). Sur Netlify, definir ces memes variables dans
# Site settings > Environment variables. NE JAMAIS committer le fichier ".env".
# ============================================================================

# --- Securite generale --------------------------------------------------
# Cle secrete utilisee pour valider les webhooks entrants (header x-conquistador-key)
# et proteger les endpoints d'administration (approbations, rapport). Choisir une
# chaine longue et aleatoire. OBLIGATOIRE.
CONQUISTADOR_API_KEY=change-moi-en-une-cle-longue-et-aleatoire
# En production, l’absence de cette clé bloque les endpoints sensibles (fail-closed).

# --- Fournisseur IA (voir src/core/aiProvider.js) ------------------------
# La vérité affichée par le dashboard et /api/health est toujours :
# Gemini → Groq → OpenRouter → Mock.
# Ordre de bascule canonique : GEMINI -> GROQ -> OPENROUTER -> MOCK
# Aucune clé IA n'est obligatoire en développement : sans fournisseur réel
# disponible, le système utilise le mode MOCK (réponse locale honnête).

# Groq (SERVICE: Groq Cloud | COUT: gratuit | LIMITES FREE: quota de requetes/minute
# et de tokens/jour selon le modele, voir https://console.groq.com/docs/rate-limits
# | OBLIGATOIRE: non)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (SERVICE: Google AI Studio | COUT: gratuit | LIMITES FREE: quota de
# requetes/minute et par jour selon le modele, voir https://ai.google.dev/pricing
# | OBLIGATOIRE: non)
# ATTENTION : Gemini 2.0 Flash a ete retire le 3 mars 2026. Le modele par
# defaut ci-dessous (gemini-2.5-flash) est le choix gratuit recommande au
# moment de la redaction (aout 2026). Verifiez https://ai.google.dev/pricing
# avant deploiement : si Google a de nouveau change les noms de modeles
# disponibles gratuitement, changez uniquement cette valeur, aucun code a modifier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (SERVICE: OpenRouter | COUT: gratuit pour les modeles suffixes ":free"
# | LIMITES FREE: 20 requetes/minute, 50 requetes/jour sans achat de credits (1000/jour
# apres un achat unique de 10$ non renouvelable) ; roster de modeles gratuits variable
# dans le temps, voir https://openrouter.ai/models?max_price=0 | OBLIGATOIRE: non)
# Troisieme et dernier fournisseur reel avant Mock (voir docs/AI_PROVIDERS.md).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Webhooks et limites HTTP ----------------------------------------------
# Secret partagé utilisé pour signer le corps brut des webhooks en HMAC-SHA256.
# En production, il est obligatoire et le header accepté est
# x-conquistador-signature: sha256=<hex> (x-hub-signature-256 accepté aussi).
CONQUISTADOR_WEBHOOK_SECRET=
REQUIRE_WEBHOOK_SIGNATURE=true
MAX_HTTP_BODY_BYTES=1048576
# Avant le premier déploiement, utiliser le mode strict même origine (jamais '*').
# Après le premier déploiement, remplacer par l'URL HTTPS exacte du site Netlify.
ALLOWED_ORIGIN=__SAME_ORIGIN__

# --- Memoire persistante (voir src/core/memory.js) -----------------------
# Supabase (SERVICE: Supabase | COUT: gratuit (plan Free) | LIMITES FREE: 500 Mo de
# base Postgres, projet mis en pause apres 7 jours d'inactivite sur le plan Free,
# voir https://supabase.com/pricing | OBLIGATOIRE: non, sinon fallback JSON local)
#
# Un projet Supabase DEDIE a ete deja cree et prepare pour ce projet
# ("conquistador-os", region eu-central-1) : le schema (docs/supabase-schema.sql)
# y est deja applique et verifie (CRUD teste sur les 10 tables). SUPABASE_URL
# est donc deja renseignee ci-dessous. Il ne reste qu'UNE seule etape manuelle :
# recuperer la cle service_role (jamais accessible automatiquement, pour des
# raisons de securite) depuis https://supabase.com/dashboard/project/sgbaltdxjdxlrqsefekf/settings/api-keys
# puis la coller dans SUPABASE_SERVICE_KEY ci-dessous (jamais la cle "anon"/
# "publishable", et jamais cette cle dans le code ou cote client).
SUPABASE_URL=https://sgbaltdxjdxlrqsefekf.supabase.co
SUPABASE_SERVICE_KEY=

# --- Meta Facebook + Instagram (serveur uniquement, ajout en phase de connexion) ---
# Ne pas créer ces variables avant que l’application Meta et le callback soient prêts.
# Les six valeurs suivantes ne doivent jamais être placées dans public/ ni envoyées dans le chat.
META_APP_ID=
META_APP_SECRET=
META_CONFIGURATION_ID=
META_OAUTH_REDIRECT_URI=https://conquistadoros1.netlify.app/api/meta/oauth/callback
# Clé AES-256-GCM : 32 octets, fournie en hex (64 caractères) ou Base64.
META_TOKEN_ENCRYPTION_KEY=
# Jeton arbitraire choisi pour la vérification GET des Webhooks Meta.
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v26.0
# Override facultatif : ne demander que les scopes validés pour la version déployée.
# META_OAUTH_SCOPE=pages_show_list,pages_read_engagement,pages_read_user_content,pages_manage_engagement,pages_manage_posts,pages_manage_metadata,pages_messaging,instagram_basic,instagram_manage_comments,instagram_manage_messages,instagram_content_publish

# --- TikTok (Login Kit + Content Posting API, serveur uniquement) -----------
# L’application TikTok et le Content Posting API doivent être créés dans
# TikTok for Developers. La publication publique peut rester limitée jusqu’à
# l’audit TikTok ; ne jamais considérer cela comme une garantie d’approbation.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=https://conquistadoros1.netlify.app/api/tiktok/oauth/callback
# Clé AES-256-GCM : 32 octets, en hexadécimal de 64 caractères ou Base64.
TIKTOK_TOKEN_ENCRYPTION_KEY=
# Scopes par défaut : identité, lecture vidéos et publication directe.
# Ne demander que les scopes effectivement validés par TikTok.
TIKTOK_OAUTH_SCOPE=user.info.basic,video.list,video.publish

# --- YouTube (Google OAuth serveur uniquement) ------------------------------
# La connexion ouvre l’autorisation officielle Google ; aucun mot de passe ni
# token ne doit être copié dans le dashboard ou dans le chat. Le scope par défaut
# lit la chaîne authentifiée et prépare le téléversement. Toute publication reste
# soumise à approbation humaine + kill switch.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://conquistadoros1.netlify.app/api/youtube/oauth/callback
# Clé AES-256-GCM : 32 octets, en hexadécimal de 64 caractères ou Base64.
YOUTUBE_TOKEN_ENCRYPTION_KEY=
YOUTUBE_OAUTH_SCOPE=https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/youtube.upload

# --- Identite du projet (utilise par les agents de contenu) --------------
BRAND_NAME=Savoir Utile
PRODUCT_NAME=La methode complete pour trouver un emploi en Afrique francophone
PRODUCT_URL=https://savoir-utile.mychariow.shop/prd_s33t0e
SHOP_URL=https://savoir-utile.mychariow.shop
# Studio vocal Rémy Neural fourni séparément. Laisser vide tant qu’il n’est pas
# hébergé sur une URL HTTPS durable accessible depuis Netlify Functions.
VOICE_STUDIO_API_URL=
VOICE_PROVIDER=Rémy Neural via edge-tts
VOICE_NAME=Rémy Neural
VOICE_STUDIO_TIMEOUT_MS=15000
# Bucket Supabase Storage (public) pour stocker durablement l'audio de voix
# off genere par le pipeline (voir src/core/mediaStorage.js). A creer
# manuellement dans le projet Supabase (Storage > New bucket > Public) avant
# la premiere utilisation ; sans Supabase configure, la voix off reste
# generee mais l'URL audio durable ne sera pas disponible (duree quand meme
# mesuree reellement et utilisee pour la timeline).
SUPABASE_MEDIA_BUCKET=conquistador-media

# --- VISUAL_CONTINUITY_POLICY (references officielles obligatoires) -------
# Ces trois chemins pointent vers les references visuelles OFFICIELLES
# fournies par Savoir Utile, deja incluses dans ce projet (voir
# assets/README.md pour le detail : bios completes, style vestimentaire,
# planches d'expressions). NE PAS supprimer ces fichiers ni changer ces
# chemins sans mettre a jour assets/ en consequence : tant qu'ils restent
# valides, le systeme considere la continuite visuelle de Samuel, Marc et du
# logo comme garantie (src/core/visualContinuity.js). Si vous videz ces
# variables, le systeme redevient honnetement bloquant (continuite non
# garantie) plutot que de le pretendre a tort.
CHARACTER_REF_SAMUEL=assets/personnages/samuel/samuel-reference-principale.jpeg
CHARACTER_REF_MARC=assets/personnages/marc/marc-reference-principale.jpg
LOGO_ASSET_ID=assets/logo/logo-savoir-utile-officiel.jpeg

# --- Video Engine (voir docs/VIDEO_ENGINE.md) ------------------------------
# Fenetre "EN_COURS" d'un verrou d'idempotence (idempotency.js/memory.js)
# avant reprise automatique en cas de crash/timeout non rattrape. 10 min par
# defaut ; ajuster seulement si vos rendus depassent regulierement ce delai.
IDEMPOTENCY_TTL_MS=600000
# Delai d'attente (ms) avant d'abandonner un appel au provider d'image IA
# reseau (pollinations par defaut). Voir src/core/imageProviders/pollinationsProvider.js.
IMAGE_PROVIDER_TIMEOUT_MS=20000
# Modele demande au provider pollinations (aucune cle API requise au moment
# de la redaction de ce fichier - voir docs/VIDEO_ENGINE.md pour les limites
# reelles connues de ce service tiers, non garanties "gratuites illimitees").
POLLINATIONS_MODEL=flux

# --- Approbation humaine (voir src/core/approval.js) ----------------------
# Surchage optionnelle du niveau par defaut par type d'action, format JSON.
# Laisser vide pour utiliser la politique equilibree par defaut definie dans
# src/core/approval.js (analyses/idees/rapports = AUTO, envois/publications = APPROVAL_REQUIRED)
APPROVAL_POLICY_OVERRIDE=

# Duree (en heures) avant qu'une approbation en attente n'expire
# automatiquement (section 15 : une approbation expiree ne peut plus jamais
# etre validee, meme si quelqu'un tente de l'approuver - il faut re-creer la
# tache pour une nouvelle demande a jour).
APPROVAL_EXPIRY_HOURS=72

# --- KILL SWITCH (mode securise global, section 13) ------------------------
# Si "true", le systeme demarre en mode securise (toutes les actions
# externes bloquees) jusqu'a desactivation manuelle explicite depuis le
# tableau de bord ou POST /api/kill-switch. Utile pour un nouvel
# environnement dont la configuration n'est pas encore finalisee. Les
# analyses/preparations continuent de fonctionner meme en mode securise.
KILL_SWITCH_DEFAULT=false

# --- Robustesse du systeme IA (section 6) -----------------------------------
# Delai maximal (ms) avant d'abandonner un appel a un fournisseur IA et de
# passer au suivant. Reduire si votre plan Netlify limite l'execution des
# fonctions (ex: 10s sur le plan Free) pour laisser du temps aux fournisseurs
# suivants dans la meme requete.
AI_PROVIDER_TIMEOUT_MS=25000
# Nombre de nouvelles tentatives (sur le MEME fournisseur) en cas d'erreur
# reseau/timeout uniquement (jamais pour une cle manquante ou un quota
# explicitement depasse, ou cela n'aiderait pas).
AI_PROVIDER_MAX_RETRIES=1
# Apres ce nombre d'echecs CONSECUTIFS, un fournisseur est automatiquement
# mis en pause temporaire ("circuit ouvert") pour eviter des appels reseau
# inutiles a chaque requete suivante.
AI_CIRCUIT_BREAKER_THRESHOLD=3
# Duree (ms) de la pause avant de redonner sa chance a un fournisseur dont
# le circuit s'est ouvert.
AI_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# --- Divers ---------------------------------------------------------------
# Limite de requetes par IP et par minute sur les endpoints publics (webhooks).
RATE_LIMIT_PER_MINUTE=30

# Repertoire de stockage du fallback JSON (avance, optionnel). Chemin relatif
# (resolu depuis la racine du projet) ou absolu. Laisser vide pour utiliser
# "data" par defaut en local, ou /tmp/conquistador-data automatiquement sur
# une fonction Netlify deployee (voir src/core/memoryStoreJson.js).
CONQUISTADOR_DATA_DIR=

# === Chariow (boutique Savoir Utile) ===
# Cle API seule : serveur UNIQUEMENT (variable Netlify), jamais dans le frontend.
CHARIOW_API_KEY=
CHARIOW_STORE_ID=
CHARIOW_BASE_URL=https://api.chariow.com/v1
CHARIOW_TIMEOUT_MS=12000

# === Autonomie Conquistador ===
# Score qualite minimum (0-100) pour toute publication automatique. Defaut : 85.
QUALITY_MIN_SCORE=85
# Fuseau horaire de planification par defaut (les heures autorisees sont locales).
CAMPAIGN_TIMEZONE=Africa/Bujumbura

# =====================================================================
# VIDEO ENGINE V2 — AJOUTS (toutes OPTIONNELLES)
# Aucune de ces variables n'est requise : sans elles, Conquistador OS
# reste entierement fonctionnel (repli sur les assets officiels).
# =====================================================================

# --- Generation d'images conditionnee par reference (optionnel) ---
# Valeurs possibles : huggingface | stability | fal | replicate | generic  (vide = desactive)
IMAGE_IMG2IMG_PROVIDER=
# Modèle image-to-image avec référence, Apache-2.0 (édition commerciale autorisée
# sous les conditions de la licence). Défaut : Qwen/Qwen-Image-Edit-2511.
IMAGE_IMG2IMG_MODEL=Qwen/Qwen-Image-Edit-2511
# Hugging Face Inference Providers (route fal-ai pour Qwen Image Edit 2511).
# Le jeton doit autoriser « Inference Providers » et l'accès au modèle Qwen.
# Il est lu UNIQUEMENT côté serveur / GitHub Secrets, jamais par le frontend.
HF_TOKEN=
# Vide = routeur officiel Hugging Face. Ne renseigner que pour un endpoint HF dédié.
HF_ENDPOINT=
STABILITY_API_KEY=
STABILITY_ENDPOINT=
FAL_API_KEY=
FAL_ENDPOINT=
REPLICATE_API_TOKEN=
REPLICATE_ENDPOINT=
IMAGE_IMG2IMG_API_KEY=
IMAGE_IMG2IMG_ENDPOINT=
IMAGE_IMG2IMG_STRENGTH=0.62
CHARACTER_REFERENCE_MAX_ATTEMPTS=2
CHARACTER_REFERENCE_MAX_REFS=3

# --- Controle de coherence visuelle de personnage (PASS / REVIEW / FAIL) ---
VISUAL_CONSISTENCY_PASS_THRESHOLD=0.78
VISUAL_CONSISTENCY_REVIEW_THRESHOLD=0.60

# --- Timeline / rendu (aucune limite de duree maximale) ---
VIDEO_FPS=30
VIDEO_DEFAULT_SCENE_SECONDS=4

# --- Diffusion des jobs video (confirmation provider obligatoire) ---
VIDEO_PUBLISH_MAX_ATTEMPTS=3

# --- Branding centralise (assets officiels ; vide = detection automatique) ---
BRAND_FONT=IBM Plex Sans
BRAND_CTA=
BRAND_LOGO_ASSET=
BRAND_LOGO_ASSET_V2=
BRAND_GUIDE_COVER_ASSET=
BRAND_BIBLE_ASSET_V1=
BRAND_BIBLE_ASSET_V2=
